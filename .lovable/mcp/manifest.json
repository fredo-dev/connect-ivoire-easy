{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lrjmqhxzppppjloigpwi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cabine-connect",
      "version": "0.1.0",
      "title": "Cabine Connect"
    },
    "tools": [
      {
        "name": "list_plans",
        "title": "Lister les forfaits",
        "description": "List available internet, call and mixed plans, optionally filtered by operator and type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "operator": {
              "type": "string",
              "enum": [
                "orange",
                "mtn",
                "moov",
                "wave"
              ],
              "description": "Operator filter."
            },
            "kind": {
              "type": "string",
              "enum": [
                "internet",
                "appels",
                "mixte"
              ],
              "description": "Plan type filter."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_profile",
        "title": "Voir mon profil",
        "description": "Return the signed-in user's name, phone number and operator.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "Historique des paiements",
        "description": "List the signed-in user's recent plan purchases and credit recharges with amounts, fees and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "success",
                "error"
              ],
              "description": "Status filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Maximum rows."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
